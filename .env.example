# PostgreSQL — dev credentials (change before any non-local deployment)
POSTGRES_USER=battery_dev
POSTGRES_PASSWORD=devpass
POSTGRES_DB=battery_dev
POSTGRES_PORT=5432

# Email for sign-in codes
#   console → codes are printed in the backend log (and returned to the app in dev)
#   smtp    → real emails via any SMTP server. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
#             SMTP_USER=you@gmail.com, SMTP_PASS=16-char App Password (Google Account →
#             Security → 2-Step Verification → App passwords). ~500 emails/day.
#   resend  → https://resend.com HTTP API; EMAIL_FROM must use a domain verified there
# Outside production, @example.com / .test addresses are never really emailed (test scripts use them).
EMAIL_PROVIDER=console
EMAIL_FROM="Ambika Battery <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
