// Prisma schema — Battery Production & Inventory Management
// Multi-tenant: every company-owned record must be scoped by companyId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum MaterialUnit {
  KG
  G
  LITRES
  ML
  PIECES
}

enum StockItemType {
  RAW_MATERIAL
  FINISHED_BATTERY
}

enum StockMovementType {
  OPENING_STOCK
  RECEIPT
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  DISPATCH
  ADJUSTMENT
  REVERSAL
}

enum ProductionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
  REVERSED
}

enum ProductionRequestEventType {
  SUBMITTED
  EDITED
  DELETED
  APPROVED
  REJECTED
  RESUBMITTED
  REVERSED
}

model Company {
  id             Int      @id @default(autoincrement())
  name           String
  invitationCode String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users              User[]
  rawMaterials       RawMaterial[]
  batteryTypes       BatteryType[]
  stockMovements     StockMovement[]
  productionRequests ProductionRequest[]
  materialReceipts   MaterialReceipt[]
  dispatches         Dispatch[]

  @@map("companies")
}

model User {
  id        Int        @id @default(autoincrement())
  companyId Int
  email     String
  name      String
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sessions       Session[]
  recipeVersions RecipeVersion[]
  stockMovements StockMovement[]

  requestedProductionRequests ProductionRequest[]      @relation("RequestedProductionRequests")
  approvedProductionRequests  ProductionRequest[]      @relation("ApprovedProductionRequests")
  rejectedProductionRequests  ProductionRequest[]      @relation("RejectedProductionRequests")
  reversedProductionRequests  ProductionRequest[]      @relation("ReversedProductionRequests")
  productionRequestEvents     ProductionRequestEvent[]
  receivedReceipts            MaterialReceipt[]
  madeDispatches              Dispatch[]

  @@unique([companyId, email], name: "company_email_unique")
  @@index([companyId])
  @@map("users")
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("sessions")
}

model RawMaterial {
  id                Int          @id @default(autoincrement())
  companyId         Int
  name              String
  unit              MaterialUnit
  lowStockThreshold Decimal      @default(0) @db.Decimal(18, 4)
  currentStock      Decimal      @default(0) @db.Decimal(18, 4)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipeItems     RecipeItem[]
  stockMovements  StockMovement[]   @relation("RawMaterialMovements")
  receipts        MaterialReceipt[]

  @@unique([companyId, name], name: "company_material_name_unique")
  @@index([companyId])
  @@index([companyId, active])
  @@map("raw_materials")
}

model BatteryType {
  id                Int      @id @default(autoincrement())
  companyId         Int
  name              String
  lowStockThreshold Int      @default(0)
  currentStock      Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipeVersions     RecipeVersion[]
  stockMovements     StockMovement[]     @relation("BatteryTypeMovements")
  productionRequests ProductionRequest[]
  dispatches         Dispatch[]

  @@unique([companyId, name], name: "company_battery_type_name_unique")
  @@index([companyId])
  @@index([companyId, active])
  @@map("battery_types")
}

model RecipeVersion {
  id            Int      @id @default(autoincrement())
  batteryTypeId Int
  version       Int
  isActive      Boolean  @default(true)
  createdById   Int
  createdAt     DateTime @default(now())

  batteryType        BatteryType         @relation(fields: [batteryTypeId], references: [id], onDelete: Restrict)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items              RecipeItem[]
  productionRequests ProductionRequest[]

  @@unique([batteryTypeId, version], name: "batterytype_version_unique")
  @@index([batteryTypeId, isActive])
  @@map("recipe_versions")
}

model RecipeItem {
  id              Int     @id @default(autoincrement())
  recipeVersionId Int
  rawMaterialId   Int
  quantityPerUnit Decimal @db.Decimal(18, 4)

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial   @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, rawMaterialId], name: "recipe_item_unique")
  @@index([recipeVersionId])
  @@index([rawMaterialId])
  @@map("recipe_items")
}

model StockMovement {
  id               Int               @id @default(autoincrement())
  companyId        Int
  itemType         StockItemType
  movementType     StockMovementType
  rawMaterialId    Int?
  batteryTypeId    Int?
  quantityChange   Decimal           @db.Decimal(18, 4)
  resultingBalance Decimal           @db.Decimal(18, 4)
  reason           String?
  referenceType    String?
  referenceId      Int?
  userId           Int
  createdAt        DateTime          @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial? @relation("RawMaterialMovements", fields: [rawMaterialId], references: [id], onDelete: Restrict)
  batteryType BatteryType? @relation("BatteryTypeMovements", fields: [batteryTypeId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, itemType, rawMaterialId])
  @@index([companyId, itemType, batteryTypeId])
  @@index([companyId, referenceType, referenceId])
  @@map("stock_movements")
}

model ProductionRequest {
  id              Int                     @id @default(autoincrement())
  companyId       Int
  batteryTypeId   Int
  recipeVersionId Int
  requestedById   Int
  quantity        Int
  status          ProductionRequestStatus @default(PENDING)
  recipeSnapshot  Json

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  approvedAt      DateTime?
  approvedById    Int?
  rejectedAt      DateTime?
  rejectedById    Int?
  rejectionReason String?
  reversedAt      DateTime?
  reversedById    Int?
  reversalReason  String?

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  batteryType   BatteryType  @relation(fields: [batteryTypeId], references: [id], onDelete: Restrict)
  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  requestedBy   User         @relation("RequestedProductionRequests", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?        @relation("ApprovedProductionRequests", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy    User?        @relation("RejectedProductionRequests", fields: [rejectedById], references: [id], onDelete: Restrict)
  reversedBy    User?        @relation("ReversedProductionRequests", fields: [reversedById], references: [id], onDelete: Restrict)
  events        ProductionRequestEvent[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, status, submittedAt])
  @@index([companyId, batteryTypeId])
  @@index([requestedById])
  @@map("production_requests")
}

model ProductionRequestEvent {
  id                  Int                        @id @default(autoincrement())
  productionRequestId Int
  eventType           ProductionRequestEventType
  actorId             Int
  reason              String?
  metadata            Json?
  createdAt           DateTime                   @default(now())

  productionRequest ProductionRequest @relation(fields: [productionRequestId], references: [id], onDelete: Cascade)
  actor             User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([productionRequestId, createdAt])
  @@index([actorId])
  @@map("production_request_events")
}

model MaterialReceipt {
  id            Int      @id @default(autoincrement())
  companyId     Int
  rawMaterialId Int
  quantity      Decimal  @db.Decimal(18, 4)
  notes         String?
  receivedById  Int
  receivedAt    DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  receivedBy  User        @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([companyId, receivedAt])
  @@index([companyId, rawMaterialId, receivedAt])
  @@map("material_receipts")
}

model Dispatch {
  id             Int      @id @default(autoincrement())
  companyId      Int
  batteryTypeId  Int
  quantity       Int
  traderName     String
  notes          String?
  dispatchedById Int
  dispatchedAt   DateTime @default(now())

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  batteryType  BatteryType @relation(fields: [batteryTypeId], references: [id], onDelete: Restrict)
  dispatchedBy User        @relation(fields: [dispatchedById], references: [id], onDelete: Restrict)

  @@index([companyId, dispatchedAt])
  @@index([companyId, batteryTypeId, dispatchedAt])
  @@index([companyId, traderName])
  @@map("dispatches")
}
