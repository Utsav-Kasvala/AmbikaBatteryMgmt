{
  "name": "battery-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test:isolation": "node scripts/test-isolation.mjs",
    "test:materials": "node scripts/test-materials.mjs",
    "test:all": "npm run test:isolation && npm run test:materials && npm run test:batteryTypes && npm run test:recipes && npm run test:stock && npm run test:productionRequests && npm run test:approval && npm run test:receiptsDispatches && npm run test:reversalLowStock",
    "test:batteryTypes": "node scripts/test-batteryTypes.mjs",
    "test:recipes": "node scripts/test-recipes.mjs",
    "test:stock": "node scripts/test-stock.mjs",
    "test:productionRequests": "node scripts/test-production-requests.mjs",
    "test:approval": "node scripts/test-approval.mjs",
    "test:receiptsDispatches": "node scripts/test-receipts-dispatches.mjs",
    "test:reversalLowStock": "node scripts/test-reversal-lowstock.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
